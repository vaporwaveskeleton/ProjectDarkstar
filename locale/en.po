msgstr "LAMP TEST"

msgid "CAB_BOOT_GLASS"
msgstr "GLASS TEST"

msgid "CAB_BOOT_OK"
msgstr "OK"

msgid "CAB_BOOT_DONE"
msgstr "SELF TEST COMPLETE"

