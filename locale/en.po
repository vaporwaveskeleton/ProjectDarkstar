#. Game title on the attract screen. Do not translate the name.
msgid "GAME_TITLE"
msgstr "DARKSTAR"

#. Attract screen primary action: start a new run. "Vigil" is the player's ship (glossary).
msgid "MENU_NEW_VIGIL"
msgstr "New Vigil"

msgid "MENU_SETTINGS"
msgstr "Settings"

msgid "MENU_BACK"
msgstr "Back"

msgid "MENU_RESUME"
msgstr "Resume"

#. Pause menu: end the current run and return to the title.
msgid "MENU_ABANDON_RUN"
msgstr "Abandon Run"

msgid "PAUSE_TITLE"
msgstr "Paused"

msgid "CONFIRM_ABANDON_TITLE"
msgstr "Abandon this run?"

#. Must stay truthful: run power is lost; Lantern Tree and banked currency persist (SYS-001 §8).
msgid "CONFIRM_ABANDON_BODY"
msgstr "Run power is lost. Your Lantern Tree and banked currency are safe."

msgid "CONFIRM_ABANDON_YES"
msgstr "Abandon"

msgid "CONFIRM_KEEP_PLAYING"
msgstr "Keep Playing"

#. Confirmation when the POWER rocker is pressed on the attract screen.
#. The Ruins pause (TECH-001 Q-T190): leave the Ruins for the title screen.
msgid "MENU_LEAVE_TO_TITLE"
msgstr "Leave for the Title"

msgid "CONFIRM_LEAVE_RUINS_TITLE"
msgstr "Leave the Ruins?"

msgid "CONFIRM_LEAVE_RUINS_BODY"
msgstr "What you bought stays. The lamp will be here when you return."

msgid "CONFIRM_LEAVE_RUINS_YES"
msgstr "Leave"

msgid "CONFIRM_QUIT_TITLE"
msgstr "Quit the game?"

#. Must stay truthful: nothing is lost on the title screen; saved progress is already written.
msgid "CONFIRM_QUIT_BODY"
msgstr "Your saved progress is kept."

msgid "CONFIRM_QUIT_YES"
msgstr "Quit"

msgid "CONFIRM_QUIT_STAY"
msgstr "Stay"

msgid "SETTINGS_TITLE"
msgstr "Settings"

#. Toggle: doubles text size (200 %).
msgid "SETTINGS_LARGE_TEXT"
msgstr "Large Text"

msgid "SETTINGS_REDUCED_MOTION"
msgstr "Reduced Motion"

#. Removes flicker and strobing. Never hides information.
msgid "SETTINGS_PHOTOSENSITIVITY"
msgstr "Photosensitivity Mode"

#. Accessibility option name from the glossary: keeps the HUD honest.
msgid "SETTINGS_STEADY_LEDGER"
msgstr "Steady Ledger"

#. Toggle: the brief spark at the gun when you fire. On by default; also off whenever Photosensitivity Mode is on.
msgid "SETTINGS_MUZZLE_FLASH"
msgstr "Weapon Muzzle Flash"

#. Tooltip for the muzzle flash toggle.
msgid "SETTINGS_MUZZLE_FLASH_DESC"
msgstr "Shows a brief spark at the gun each time you fire. Turn it off if flashes bother you."

#. Settings row description (shown under the page when the row has focus).
msgid "SETTINGS_LARGE_TEXT_DESC"
msgstr "Doubles the size of menu text."

#. Settings row description.
msgid "SETTINGS_REDUCED_MOTION_DESC"
msgstr "Swaps strong motion, such as shakes and sweeps, for calmer versions."

#. Settings row description. Must stay true: the mode never hides information (GDD §10).
msgid "SETTINGS_PHOTOSENSITIVITY_DESC"
msgstr "Removes flicker, flashes and strobing. Nothing you need is hidden."

#. Settings row description. Steady Ledger is a glossary name (WARP-001 §4.4).
msgid "SETTINGS_STEADY_LEDGER_DESC"
msgstr "Keeps the HUD honest: its readouts never lie, and Esc always pauses."

#. Settings preview window, when the focused row has no preview (a tab, Back, a controls row).
msgid "SETTINGS_PREVIEW_IDLE"
msgstr "Preview"

#. Settings preview: the sample word shown at 100 % and 200 % text. A glossary word.
msgid "SETTINGS_PREVIEW_TEXT"
msgstr "Vigil"

#. Settings preview: caption over the HUD digit that lies under warp (WARP-001 §4.2).
msgid "SETTINGS_PREVIEW_HUD"
msgstr "HUD"

#. Settings preview: caption over the Steady Ledger digit, which never lies (WARP-001 §4.4).
msgid "SETTINGS_PREVIEW_LEDGER"
msgstr "Ledger"

#. Toggle value: the setting is on.
msgid "SETTINGS_ON"
msgstr "On"

#. Toggle value: the setting is off.
msgid "SETTINGS_OFF"
msgstr "Off"

#. Settings page tab.
msgid "SETTINGS_TAB_ACCESSIBILITY"
msgstr "Accessibility"

msgid "SETTINGS_TAB_ACCESSIBILITY_DESC"
msgstr "Text size, motion, flashes and an honest HUD."

#. Settings page tab.
msgid "SETTINGS_TAB_VIDEO"
msgstr "Video"

msgid "SETTINGS_TAB_VIDEO_DESC"
msgstr "How weapon effects look on screen."

#. Settings page tab: the volume sliders (AUDIO-001 §8.4).
msgid "SETTINGS_TAB_AUDIO"
msgstr "Audio"

msgid "SETTINGS_TAB_AUDIO_DESC"
msgstr "How loud each kind of sound is. Left and right change a slider; Back returns to the tabs."

#. Volume slider: the whole game.
msgid "SETTINGS_VOL_MASTER"
msgstr "Master"

msgid "SETTINGS_VOL_MASTER_DESC"
msgstr "The volume of everything. Left and right change it."

#. Volume slider: music.
msgid "SETTINGS_VOL_MUSIC"
msgstr "Music"

msgid "SETTINGS_VOL_MUSIC_DESC"
msgstr "The volume of the music. Warnings and cues are not on this slider, so turning it down hides nothing."

#. Volume slider: the Choir's chant and keening. Choir is a glossary word.
msgid "SETTINGS_VOL_CHOIR"
msgstr "Choir"

msgid "SETTINGS_VOL_CHOIR_DESC"
msgstr "The volume of the Choir's chant and keening, which tell you where they are."

#. Volume slider: the entity's spoken lines. It cannot be turned fully off.
msgid "SETTINGS_VOL_ENTITY"
msgstr "Entity voice"

msgid "SETTINGS_VOL_ENTITY_DESC"
msgstr "The volume of the entity's spoken lines. It stops short of silence, because the lines tell you what state the run is in."

#. Volume slider: menu and readout sounds.
msgid "SETTINGS_VOL_UI"
msgstr "UI and readouts"

msgid "SETTINGS_VOL_UI_DESC"
msgstr "The volume of menu sounds and the tally, apart from the world around you."

#. Volume slider: the ship's brass, the clock and the ambience. It cannot be turned fully off.
msgid "SETTINGS_VOL_FOLEY"
msgstr "Foley and ambience"

msgid "SETTINGS_VOL_FOLEY_DESC"
msgstr "The volume of the ship's brass, the clock and the background beds. It stops short of silence so a warning chime is never lost."

#. Settings page tab: a read-only reference of the current bindings.
msgid "SETTINGS_TAB_CONTROLS"
msgstr "Controls"

msgid "SETTINGS_TAB_CONTROLS_DESC"
msgstr "What each control does, on keyboard and mouse and on a gamepad."

#. Act 0 only: the cabinet's settings page is its operator service mode (a period arcade term).
msgid "MENU_SERVICE_MODE"
msgstr "Service Mode"

#. Controls reference: column headings.
msgid "CONTROLS_COLUMN_ACTION"
msgstr "Action"

msgid "CONTROLS_COLUMN_KEYS"
msgstr "Keyboard"

msgid "CONTROLS_COLUMN_PAD"
msgstr "Gamepad"

#. Controls reference: an action with no binding on that device.
msgid "CONTROLS_UNBOUND"
msgstr "-"

#. Controls reference rows (GDD §4.1 action names; glossary words).
msgid "CONTROLS_MOVE"
msgstr "Move"

msgid "CONTROLS_AIM"
msgstr "Aim"

msgid "CONTROLS_FIRE_LANCE"
msgstr "Fire Arc-Lance"

msgid "CONTROLS_DEPLOY_CHARGE"
msgstr "Deploy Charge"

msgid "CONTROLS_SURGELIGHT"
msgstr "Surgelight"

msgid "CONTROLS_LANTERN"
msgstr "Lantern"

msgid "CONTROLS_BRAKE"
msgstr "Brake"

msgid "CONTROLS_CODEX"
msgstr "Codex"

msgid "CONTROLS_PAUSE"
msgstr "Pause"

#. HUD readout of the Vigil's remaining hull. {count} is a number.
msgid "HUD_HULL_COUNT"
msgid_plural "HUD_HULL_COUNT_PLURAL"
msgstr[0] "Hull {count}"
msgstr[1] "Hull {count}"

#. Shown when the hull is breached in the bootstrap sector.
msgid "HUD_HULL_BREACHED"
msgstr "Hull breached"

#. Engraved caption on the brass Vigil Index plate (score), Aether HUD top-right.
msgid "HUD_PLATE_INDEX"
msgstr "INDEX"

#. Engraved caption on the brass Charge pip strip, Aether HUD bottom-left.
msgid "HUD_PLATE_CHARGES"
msgstr "CHARGES"

#. Engraved caption on the brass Surgelight pip strip (Aether handling plate, right of the Seam plaque).
msgid "HUD_PLATE_SURGE"
msgstr "SURGE"

#. Engraved caption on the brass Seam index plaque, Aether HUD bottom-centre.
msgid "HUD_PLATE_SEAM"
msgstr "SEAM"

#. Steady Ledger honest Warp Tier read (WARP-001 §4.4). {count} is the tier number.
msgid "HUD_LEDGER_TIER"
msgid_plural "HUD_LEDGER_TIER_PLURAL"
msgstr[0] "TIER {count}"
msgstr[1] "TIER {count}"

msgid "MSG_SAVE_FAILED"
msgstr "Progress could not be saved. Your last saved progress is safe. Try again from the Ruins."

msgid "MSG_SAVE_NEWER_VERSION"
msgstr "This save is from a newer version of DARKSTAR. Update the game to continue it."

msgid "MSG_SAVE_CORRUPT"
msgstr "A save file could not be read. Your other progress is safe."

msgid "MSG_SAVE_RECOVERED"
msgstr "A save file was damaged. Your most recent backup was restored."

msgid "MSG_SCREEN_FAILED"
msgstr "That screen could not open. Your progress is safe. Returning to the title."

#. Act 0 cabinet bezel (the arcade costume, WARP-001 W0-01/W0-04). Arcade house style: capitals.
msgid "CAB_1UP"
msgstr "1UP"

msgid "CAB_HI"
msgstr "HI"

#. Shown in place of the segment count once the Sepulchre is awake.
msgid "CAB_SEP_AWAKE"
msgstr "AWAKE"

#. Blinks at the foot of the bezel. Part of the arcade costume.
msgid "CAB_CREDIT"
msgstr "INSERT CREDIT"

#. The cabinet maker's mark. The Lantern Office is the in-world body that built the machine (NARR-001, spoiler tier S1).
msgid "CAB_MAKER"
msgstr "© LANTERN OFFICE"

msgid "CAB_READY"
msgstr "READY, VIGIL"

#. A0-1 title card. The Sepulchre here is cold: it never wakes.
msgid "CAB_STAGE_A0_1"
msgstr "FIRST VIGIL"

msgid "CAB_STAGE_A0_1_SUB"
msgstr "MINE THE GLASS. BREAK THE SEPULCHRE."

#. A0-2 title card. Still a cold Sepulchre; the Grubs steal the Glass. WORDING PROPOSED.
msgid "CAB_STAGE_A0_2"
msgstr "SECOND VIGIL"

#. WORDING PROPOSED.
msgid "CAB_STAGE_A0_2_SUB"
msgstr "THE GRUBS STEAL. BREAK THE SEPULCHRE."

#. A0-3 title card: the first level where the entity wakes. WORDING PROPOSED.
msgid "CAB_STAGE_A0_3"
msgstr "THIRD VIGIL"

#. WORDING PROPOSED.
msgid "CAB_STAGE_A0_3_SUB"
msgstr "CENSERS SWING. UNMAKE WHAT WAKES."

#. A0-4 title card: a dense Glass field. WORDING PROPOSED.
msgid "CAB_STAGE_A0_4"
msgstr "FOURTH VIGIL"

#. WORDING PROPOSED.
msgid "CAB_STAGE_A0_4_SUB"
msgstr "RICH GLASS. HUNGRY GRUBS."

#. A0-5 title card: the last stage of the shift; THE PRETENCE follows it.
msgid "CAB_STAGE_A0_5"
msgstr "THE LAST NORMAL DAY"

msgid "CAB_STAGE_A0_5_SUB"
msgstr "THEY ARE BUILDING SOMETHING. STOP THEM."

#. Zone line, small, above a READY card title (A0-2). WORDING PROPOSED.
msgid "CAB_ZONE_DRIFT"
msgstr "ENTERING THE DRIFT"

#. Zone line above the A0-3 READY card title. WORDING PROPOSED.
msgid "CAB_ZONE_CENSER_WATCH"
msgstr "ENTERING CENSER WATCH"

#. Zone line above the A0-4 READY card title. WORDING PROPOSED.
msgid "CAB_ZONE_SHOAL"
msgstr "ENTERING THE SHOAL"

#. Zone line above the A0-5 READY card title. WORDING PROPOSED.
msgid "CAB_ZONE_STILLWATER"
msgstr "ENTERING STILLWATER"

msgid "CAB_GAME_OVER"
msgstr "GAME OVER"

msgid "CAB_VIGIL_COMPLETE"
msgstr "VIGIL COMPLETE"

msgid "CAB_ENTITY_DOWN"
msgstr "THE DARK STAR IS DOWN"

msgid "CAB_EXTRA_VIGIL"
msgstr "EXTRA VIGIL"

#. Caption for the chant (GDD §10: the chant is audio-critical, so it is always captioned).
msgid "CAB_CAPTION_WHISPER"
msgstr "[ a choir sings, close by ]"

#. The cabinet's credits roll. It is propaganda: cheerful, official, slightly wrong.
msgid "CAB_CREDITS_1"
msgstr "CONGRATULATIONS, VIGIL"

msgid "CAB_CREDITS_2"
msgstr "THE LIGHT IS SAFE"

msgid "CAB_CREDITS_3"
msgstr "YOUR QUOTA IS MET"

#. S7 service record. Wording approved by the owner 2026-11-18, NARR-001 §7.5; counts are true.
msgid "CAB_CREDITS_STAT_GRUBS"
msgstr "GRUBS DESTROYED: %d"

#. S7 service record. Wording approved by the owner 2026-11-18, NARR-001 §7.5; counts are true.
msgid "CAB_CREDITS_STAT_MINED"
msgstr "GLASS MINED: %d"

#. S7 service record. Wording approved by the owner 2026-11-18, NARR-001 §7.5; counts are true.
msgid "CAB_CREDITS_STAT_CHARGES"
msgstr "CHARGES THROWN: %d"

#. S7 service record. Wording approved by the owner 2026-11-18, NARR-001 §7.5; counts are true.
msgid "CAB_CREDITS_STAT_CARRIED"
msgstr "GLASS CARRIED: %d"

#. Mid-shift stage tally title, followed by the four stat lines for that stage only. {n} is the 1-based stage number, filled in code (L10N-001 §3). WORDING PROPOSED.
msgid "CAB_TALLY_TITLE"
msgstr "VIGIL {n} TALLY"

msgid "CAB_CREDITS_4"
msgstr "DARKSTAR"

msgid "CAB_CREDITS_5"
msgstr "A LANTERN OFFICE PRODUCTION"

msgid "CAB_CREDITS_6"
msgstr "KEEP THE VIGIL"

msgid "CAB_CREDITS_7"
msgstr "THANK YOU FOR YOUR SERVICE"

#. The entity's only line in Act 0 (AUDIO-001 §4.1, locked). Big type, never animated.
msgid "ENTITY_IT_WAKES"
msgstr "IT WAKES."

#. The Cabinet's last ROM screen (NARR-001 §9.5). Shown ONLY in ending 5, after Theodora Lune's message; a normal clear never reaches it (the Decay, GDD §6.1 A0-5). Also the line on her maker's plate (§5.4).
msgid "REVEAL_PRETENCE"
msgstr "THAT WAS A PRETENCE."


#. The Ruins, first visit (NARR-001 §5.7; LOOP-001 §10.5). Sable's chalk: sentence case, second
#. person, present tense, never a question. The first two are the first words read after THE PRETENCE.
msgid "NARR_SABLE_FIRST_1"
msgstr "You're back. Most aren't."

#. The anchoring rule (GDD §6.2; LOOP-001 §2), stated once, diegetically. Never in a menu.
msgid "NARR_SABLE_FIRST_2"
msgstr "What you buy here stays. The rest goes back into the dark."

#. Chalk tally of the player's Act 0 Vigil Index. {n} = the number (plain integer).
msgid "NARR_SABLE_TALLY"
msgstr "Counted: {n}."

#. Sable's slate on every later Ruins visit.
msgid "NARR_SABLE_RETURN_1"
msgstr "You return. What you carried is counted."

#. Chalk on the floor under the Lantern Tree (first visit).
msgid "NARR_SABLE_TREE"
msgstr "Light one. The dark is long."

#. Chalk by the Hourglass, first visit: the clock starts at the launch (beat 11).
msgid "NARR_SABLE_GLASS"
msgstr "The sand starts when you leave."

#. Chalk by the Hourglass on later visits: the clock runs in the Ruins too.
msgid "NARR_SABLE_GLASS_RETURN"
msgstr "The sand runs while you stand here."

#. Hidden chalk on the wall, readable only with the lantern down (the beat 15 pre-echo).
msgid "NARR_SABLE_DARK_1"
msgstr "Some things are written only for the dark."

#. The wall Cabinet's marquee as it pays out (NARR-001 §5.7, Cabinet register: caps, no period).
msgid "NARR_CAB_SCORE_BANKED"
msgstr "SCORE BANKED"

#. A brass plate by the Lantern Tree: the tickets hung there. {n} = Ember banked (1 ticket = 1 Ember).
msgid "RUINS_TICKET_PLATE"
msgstr "{n} EMBER"

#. Running head of a Codex page seen close up at the Codex desk.
msgid "RUINS_CODEX_HEADER"
msgstr "CODEX"

#. Codex entry cx_place_act0_3 (NARR-001 §8.4), the first Ruins visit's stamped page.
msgid "CX_PLACE_ACT0_3_TITLE"
msgstr "Last Normal Day (cabinet stage)"

msgid "CX_PLACE_ACT0_3_BODY"
msgstr "Pretence Hall curriculum, stage five, the last of the training rotation. A simulation: in it the Dark Star always lost, by design. Final screen retained as written by the curriculum's author."

#. Shown under the title once Act 0 has been finished. The arcade is no longer innocent.
msgid "ATTRACT_FIRST_SKY_DARK"
msgstr "THE FIRST SKY IS DARK."

#. Cabinet power-on self-test (owner request 2026-11-18). Arcade house style: capitals, ≤ 6 words.
msgid "CAB_BOOT_HEADER"
msgstr "VIGIL HALL TRAINING CABINET"

msgid "CAB_BOOT_RAM"
msgstr "RAM TEST"

msgid "CAB_BOOT_ROM"
msgstr "ROM TEST"

#. The Charge lamps on the bezel.
