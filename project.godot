; Engine configuration file.
; DARKSTAR — settings owned by TECH-001 §1.2. Change them there first.

config_version=5

[application]

config/name="DARKSTAR"
config/description="DARKSTAR — 2D arcade roguelike (Godot 4.7.2, GDScript)."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/output_latency=60
buses/default_bus_layout="res://data/audio/default_bus_layout.tres"

[autoload]

SettingsService="*res://autoload/settings_service.gd"
SaveService="*res://autoload/save_service.gd"
SceneRouter="*res://autoload/scene_router.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1
window/hidpi/nearest_filtering=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gui]

theme/custom="res://data/ui/darkstar_theme.tres"
common/default_focus_mode_on_click=false

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65,"unicode":97)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68,"unicode":100)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)
]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87,"unicode":119)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)
]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83,"unicode":115)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)
]
}
aim_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0)
]
}
aim_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0)
]
}
aim_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0)
]
}
aim_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0)
]
}
fire_lance={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1)
, Object(InputEventJoypadMotion,"device":-1,"axis":5,"axis_value":1.0)
]
}
deploy_charge={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":2)
, Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0)
]
}
surgelight={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325)
, Object(InputEventJoypadButton,"device":-1,"button_index":0)
]
}
lantern_toggle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69,"unicode":101)
, Object(InputEventJoypadButton,"device":-1,"button_index":2)
]
}
ward_pulse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81,"unicode":113)
, Object(InputEventJoypadButton,"device":-1,"button_index":1)
]
}
unravel_focus={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82,"unicode":114)
, Object(InputEventJoypadButton,"device":-1,"button_index":3)
]
}
brake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32,"unicode":32)
, Object(InputEventJoypadButton,"device":-1,"button_index":7)
]
}
relic_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":49,"unicode":49)
]
}
relic_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":50,"unicode":50)
]
}
relic_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":51,"unicode":51)
]
}
open_codex={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306)
, Object(InputEventJoypadButton,"device":-1,"button_index":4)
]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305)
, Object(InputEventJoypadButton,"device":-1,"button_index":6)
]
}

[internationalization]

locale/translations=PackedStringArray("res://locale/en.po")
locale/fallback="en"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="vigil"
2d_physics/layer_3="choir"
2d_physics/layer_4="vigil_shots"
2d_physics/layer_5="choir_shots"
2d_physics/layer_6="pickups"
2d_physics/layer_7="interactables"
2d_physics/layer_8="shroud"
2d_physics/layer_9="vigil_hurtbox"
2d_physics/layer_10="choir_hurtbox"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.0392157, 0.0392157, 0.0705882, 1)
