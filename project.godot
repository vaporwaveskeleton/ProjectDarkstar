[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="vigil"
2d_physics/layer_3="choir"
2d_physics/layer_4="vigil_shots"
2d_physics/layer_5="choir_shots"
2d_physics/layer_6="pickups"
2d_physics/layer_7="interactables"
2d_physics/layer_8="shroud"
2d_physics/layer_9="vigil_hurtbox"
2d_physics/layer_10="choir_hurtbox"

[rendering]

textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.0392157, 0.0392157, 0.0705882, 1)
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false
anti_aliasing/quality/msaa_2d=2
