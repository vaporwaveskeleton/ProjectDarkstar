; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DARKSTAR"
config/description="DARKSTAR — 2D arcade roguelike (Godot 4.7.2, GDScript)."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="res://data/audio/default_bus_layout.tres"
driver/output_latency=60

[autoload]

SettingsService="*res://autoload/settings_service.gd"
SaveService="*res://autoload/save_service.gd"
SceneRouter="*res://autoload/scene_router.gd"
AudioService="*res://autoload/audio_service.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/hidpi/nearest_filtering=false

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gui]

theme/custom="res://data/ui/darkstar_theme.tres"
common/default_focus_mode_on_click=false

