# --- Godot 4 -----------------------------------------------------------------
# Import cache and editor state (regenerated by `--import`). Commit *.import and *.uid files.
.godot/
/android/
*.translation
# Export output
/build/
/export/
*.pck
# export_presets.cfg IS tracked: it must stay credential-free (no signing, no Steam fields).
# Signing/Steam values live in a local override, never committed (guarded by test_export_presets.gd).

# --- Test output (GdUnit4) ---------------------------------------------------
/reports/
addons/gdUnit4/GdUnitRunner.cfg
.gdunit/

# --- Third-party tool binaries (too large / licensed; install locally) -------
# tools/godot: Godot 4.7.2 stable win64 — download from godotengine.org (see README).
/tools/godot/*
!/tools/godot/README.md
# tools/aseprite: local Aseprite build (licensed). Only our MCP agent notes are tracked.
/tools/aseprite/*
!/tools/aseprite/ai-artist/
# tools/pixel-art: scratch backups made by fix scripts
/tools/pixel-art/backup_*/
/tools/pixel-art/_verify_backup/
/tools/pixel-art/_hash_before.txt
/tools/pixel-art/out/
*.exe
*.dll
*.pdb
*.zip
*.7z

# --- Large / third-party asset folders ---------------------------------------
# Mood references are third-party images (ART-001 §9): never committed.
/assets/reference/*
!/assets/reference/README.md
# Raw recording sessions and source stems stay off git; mastered game audio goes in via LFS (.gitattributes).
/assets/audio/_raw/
/assets/audio/_stems/

# --- Local AI / session scratch ----------------------------------------------
/Claude outputs/
/research/
.claude/settings.local.json
.claude/worktrees/

# --- OS / editors ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
.vscode/
!/tools/aseprite/ai-artist/.vscode/
.idea/
*.swp

# --- Reference sprites (D-13: never loaded, never shipped, never pushed) -------
# The v0.1 raster pass stays on local disks as the look the generators reproduce.
# Godot ignores the folder (.gdignore), so no export can include it.
/assets/sprites/*
!/assets/sprites/.gdignore
!/assets/sprites/SPRITE_MANIFEST.csv

# --- chirp (sound as code, D-14) ------------------------------------------------
# The tool is a third-party Node project installed per machine (README); its renders are committed.
/.claude/skills/chirp-game-audio/
/assets/audio/generated/_preview/
# pxl (pixel art as code): third-party Node tool, installed per machine (README)
/.claude/skills/pxl/
/assets/art/generated/_preview/
# loom (textures as code): third-party Node tool, installed per machine at a pinned commit (README);
# its renders are committed, except previews and the maps Godot 2D does not read (ART-001 §14.8a).
/.claude/skills/loom/
/assets/art/generated/textures/_preview/
/assets/art/generated/textures/*/*_height.png*
/assets/art/generated/textures/*/*_roughness.png*
/assets/art/generated/textures/*/*_metallic.png*
/assets/art/generated/textures/*/*_ao.png*
/art/src/out/

# ComfyUI concept-art outputs are local-only reference (docs/04-production/COMFYUI_WORKFLOW.md)
/research/comfyui_out/
/tools/comfyui/out/
/tools/comfyui/__pycache__/
