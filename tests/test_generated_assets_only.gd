extends GdUnitTestSuite
## GDD-001 D-13 / D-14 (D-14 amended 2026-11-18): every image is generated at runtime (vector or
## shader); every sound is generated by code — at runtime (SfxSynth) or rendered by chirp from a
## committed `audio/src/*.cx.js` source into `assets/audio/generated/`. Nothing recorded, ever.
## ART-001 §14, AUDIO-001 §11.

const ROOTS := ["res://features", "res://scenes", "res://core", "res://autoload", "res://data"]
const IMAGE_FONT_EXT := ["png", "jpg", "jpeg", "webp", "svg", "bmp", "tga", "exr", "hdr", "ktx",
	"ttf", "otf", "woff", "woff2", "fnt", "font"]
const AUDIO_EXT := ["wav", "ogg", "mp3", "flac"]
const IMAGE_FONT_TYPES := ["Texture2D", "CompressedTexture2D", "ImageTexture", "AtlasTexture", "FontFile", "SpriteFrames"]
const AUDIO_TYPES := ["AudioStreamWAV", "AudioStreamOggVorbis", "AudioStreamMP3"]
const CHIRP_OUT := "res://assets/audio/generated/"
const CHIRP_SRC := "res://audio/src"


static func _files(root: String, exts: PackedStringArray) -> PackedStringArray:
	var out := PackedStringArray()
	var dir := DirAccess.open(root)
	if dir == null:
		return out
	dir.list_dir_begin()
	var n := dir.get_next()
	while n != "":
		var full := root.path_join(n)
		if dir.current_is_dir():
			if not n.begins_with(".") and n != "tests" and n != "_preview":
				out.append_array(_files(full, exts))
		else:
			for e in exts:
				if n.ends_with(e):
					out.append(full)
					break
		n = dir.get_next()
	return out


func test_no_game_file_references_an_image_or_font() -> void:
	var path_re := RegEx.create_from_string("res://[^\"'\\s)]+\\.(%s)\\b" % "|".join(IMAGE_FONT_EXT))
	var type_re := RegEx.create_from_string("\\[ext_resource type=\"(%s)\"" % "|".join(IMAGE_FONT_TYPES))
	var bad: Array[String] = []
	for root in ROOTS:
		for f in _files(root, [".gd", ".tscn", ".tres", ".gdshader"]):
			var text := FileAccess.get_file_as_string(f)
			var m := path_re.search(text)
			if m != null:
				bad.append("%s → %s" % [f, m.get_string(0)])
			var m2 := type_re.search(text)
			if m2 != null:
				bad.append("%s → ext_resource %s" % [f, m2.get_string(1)])
	assert_array(bad).override_failure_message("D-13 violated (generate it in code instead): %s" % [bad]).is_empty()


func test_audio_files_come_only_from_chirp_output() -> void:
	var path_re := RegEx.create_from_string("res://[^\"'\\s)]+\\.(%s)\\b" % "|".join(AUDIO_EXT))
	var type_re := RegEx.create_from_string("\\[ext_resource type=\"(%s)\"[^\\]]*path=\"([^\"]+)\"" % "|".join(AUDIO_TYPES))
	var bad: Array[String] = []
	for root in ROOTS:
		for f in _files(root, [".gd", ".tscn", ".tres", ".gdshader"]):
			var text := FileAccess.get_file_as_string(f)
			for m in path_re.search_all(text):
				if not m.get_string(0).begins_with(CHIRP_OUT):
					bad.append("%s → %s" % [f, m.get_string(0)])
			for m in type_re.search_all(text):
				if not m.get_string(2).begins_with(CHIRP_OUT):
					bad.append("%s → %s" % [f, m.get_string(2)])
	assert_array(bad).override_failure_message("D-14: audio may only come from %s (chirp renders): %s" % [CHIRP_OUT, bad]).is_empty()


func test_every_chirp_render_has_a_committed_source() -> void:
	var sources := ""
	for f in _files(CHIRP_SRC, [".cx.js", ".cx.ts"]):
		sources += FileAccess.get_file_as_string(f) + "\n"
	assert_str(sources).override_failure_message("no chirp sources found in %s" % CHIRP_SRC).is_not_empty()
	var missing: Array[String] = []
	for wav in _files(CHIRP_OUT.trim_suffix("/"), [".wav", ".ogg"]):
		var id := wav.get_file().get_basename()
		var declared := ("sfx(\"%s\"" % id) in sources or ("song(\"%s\"" % id) in sources or ("bank(\"%s\"" % id) in sources
		if not declared:
			missing.append(wav)
	assert_array(missing).override_failure_message("renders with no .cx.js source (rebuild or delete them): %s" % [missing]).is_empty()


func test_chirp_sources_use_no_recordings() -> void:
	# chirp's sample() and sample-based inst() play recordings: D-14 forbids them.
	var bad: Array[String] = []
	var re := RegEx.create_from_string("\\bsample\\s*\\(|sample\\s*:")
	var comment := RegEx.create_from_string("//[^\\n]*|/\\*[\\s\\S]*?\\*/")
	for f in _files(CHIRP_SRC, [".cx.js", ".cx.ts"]):
		var code := comment.sub(FileAccess.get_file_as_string(f), "", true)
		if re.search(code) != null:
			bad.append(f)
	assert_array(bad).override_failure_message("D-14: recordings are not allowed in chirp sources: %s" % [bad]).is_empty()


func test_project_settings_load_no_image_font_or_audio_file() -> void:
	var text := FileAccess.get_file_as_string("res://project.godot")
	var re := RegEx.create_from_string("res://[^\"]+\\.(%s)\"" % "|".join(IMAGE_FONT_EXT + AUDIO_EXT))
	assert_object(re.search(text)).override_failure_message("project.godot references an image/audio/font file").is_null()


func test_every_cabinet_cue_has_a_chirp_render() -> void:
	for id in SfxSynth.build_cabinet_set():
		assert_bool(AudioService.uses_chirp(id)).override_failure_message("cue %s has no chirp render" % id).is_true()
	assert_object(AudioService.chirp_stream(&"chant")).is_not_null()


func test_the_runtime_synth_still_builds_every_cue() -> void:
	# the fallback (and the future runtime morph layer) must keep working without the renders
	var cues := SfxSynth.build_cabinet_set()
	assert_int(cues.size()).is_greater(10)
	for id in cues:
		var s: AudioStream = cues[id]
		assert_bool(s is AudioStreamWAV).is_true()
		assert_int((s as AudioStreamWAV).data.size()).override_failure_message("cue %s is empty" % id).is_greater(0)
