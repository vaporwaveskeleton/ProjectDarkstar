{
	"format": "darkstar.scenario",
	"version": 1,
	"id": "m1_sector_look_capture",
	"profile": "dev",
	"args": [],
	"fixtures": {},
	"timeout_frames": 1200,
	"steps": [
		{"do": "wait_route", "route": "attract", "within": 120},
		{"do": "goto", "route": "sector"},
		{"do": "wait_route", "route": "sector", "within": 240},
		{"do": "wait_frames", "frames": 60},
		{"do": "screenshot", "name": "sl_01_entry", "target": "window"},
		{"do": "press", "action": "aim_right"},
		{"do": "wait_frames", "frames": 10},
		{"do": "press", "action": "fire_lance"},
		{"do": "wait_until", "id": "sector/field", "prop": "geodes_alive", "lt": 10, "within": 300},
		{"do": "release", "action": "fire_lance"},
		{"do": "release", "action": "aim_right"},
		{"do": "hold", "action": "move_right", "frames": 30},
		{"do": "wait_until", "id": "sector/field", "prop": "charges", "gte": 1, "within": 300},
		{"do": "screenshot", "name": "sl_02_glass", "target": "window"},
		{"do": "hold", "action": "move_down", "frames": 40},
		{"do": "wait_frames", "frames": 30},
		{"do": "mouse_move", "x": 632, "y": 350},
		{"do": "wait_frames", "frames": 4},
		{"do": "mouse_button", "button": "right", "pressed": true},
		{"do": "wait_frames", "frames": 2},
		{"do": "mouse_button", "button": "right", "pressed": false},
		{"do": "wait_until", "id": "sector/field", "prop": "charges_in_flight", "eq": 1, "within": 10},
		{"do": "wait_frames", "frames": 40},
		{"do": "screenshot", "name": "sl_03_charge_flight", "target": "window"},
		{"do": "wait_until", "id": "sector/field", "prop": "charges_hit", "gte": 1, "within": 420},
		{"do": "screenshot", "name": "sl_04_charge_hit", "target": "window"},
		{"do": "wait_frames", "frames": 120},
		{"do": "screenshot", "name": "sl_05_later", "target": "window"},
		{"do": "quit"}
	]
}
