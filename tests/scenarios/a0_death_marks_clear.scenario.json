{
	"format": "darkstar.scenario",
	"version": 1,
	"id": "a0_death_marks_clear",
	"args": [],
	"timeout_frames": 1200,
	"steps": [
		{"do": "wait_route", "route": "attract", "within": 120},
		{"do": "coin"},
		{"do": "wait_until", "id": "attract/ui/NewVigil", "prop": "enabled", "eq": true, "within": 240},
		{"do": "activate", "id": "attract/ui/NewVigil"},
		{"do": "wait_route", "route": "cabinet", "within": 240},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "play", "within": 600},
		{"do": "kill_all"},
		{"do": "set_lives", "lives": 3},
		{"do": "wait_until", "id": "cabinet/vigil", "prop": "shield", "lte": 0, "within": 240},
		{"do": "spawn", "kind": "acolyte", "dx": 0, "dy": -90},
		{"do": "shoot_vigil", "dx": 0, "dy": -90},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "dead", "within": 300},
		{"do": "assert", "id": "cabinet/vigil", "prop": "killer_kind", "eq": "shot"},
		{"do": "assert", "id": "cabinet/vigil", "prop": "death_marks", "eq": 1},
		{"do": "wait_frames", "frames": 60},
		{"do": "assert", "id": "cabinet/vigil", "prop": "death_marks", "eq": 1},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "play", "within": 400},
		{"do": "assert", "id": "cabinet/vigil", "prop": "alive", "eq": true},
		{"do": "assert", "id": "cabinet/vigil", "prop": "death_marks", "eq": 0},
		{"do": "assert", "id": "cabinet/vigil", "prop": "killer_kind", "eq": "none"},
		{"do": "assert", "id": "cabinet/score", "prop": "lives", "eq": 2},
		{"do": "quit"}
	]
}
