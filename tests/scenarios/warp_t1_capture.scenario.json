{
	"format": "darkstar.scenario",
	"version": 1,
	"id": "warp_t1_capture",
	"profile": "dev",
	"args": ["--warp-showcase"],
	"fixtures": {},
	"timeout_frames": 2400,
	"steps": [
		{"do": "wait_route", "route": "attract", "within": 240},
		{"do": "set_setting", "key": "steady_ledger", "value": false},
		{"do": "goto", "route": "sector"},
		{"do": "wait_route", "route": "sector", "within": 240},
		{"do": "assert", "id": "sector/warp", "prop": "warp_tier", "eq": 1},
		{"do": "wait_frames", "frames": 60},
		{"do": "assert", "id": "sector/warp", "prop": "warp_live", "eq": 0},
		{"do": "screenshot", "name": "warp_t1_00_entry_quiet", "target": "window"},
		{"do": "wait_until", "id": "sector/warp", "prop": "warp_live", "gte": 5, "within": 120},
		{"do": "wait_frames", "frames": 180},
		{"do": "assert", "id": "sector/warp", "prop": "warp_teeth", "gt": 0},
		{"do": "assert", "id": "sector/warp", "prop": "warp_cost_ms", "lte": 1.2},
		{"do": "checkpoint", "name": "standing_set_live"},
		{"do": "screenshot", "name": "warp_t1_01_standing_w1_01_02_03_05_08", "target": "window"},
		{"do": "hold", "action": "move_right", "frames": 40},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "warp_t1_02_parallax_in_motion_w1_03", "target": "window"},
		{"do": "wait_until", "id": "sector/warp", "prop": "warp_smear", "eq": true, "within": 240},
		{"do": "wait_frames", "frames": 50},
		{"do": "screenshot", "name": "warp_t1_03_smudged_blip_w1_09", "target": "window"},
		{"do": "wait_until", "id": "sector/warp", "prop": "warp_glyph", "eq": true, "within": 300},
		{"do": "wait_frames", "frames": 10},
		{"do": "screenshot", "name": "warp_t1_04_ledger_smudge_w1_10", "target": "window"},
		{"do": "wait_until", "id": "sector/warp", "prop": "warp_frayed_edge", "eq": true, "within": 360},
		{"do": "assert", "id": "sector/vigil", "prop": "composure_band", "eq": "frayed"},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "warp_t1_05_chromatic_edge_w1_06", "target": "window"},
		{"do": "wait_until", "id": "sector/warp", "prop": "warp_false_chant", "eq": true, "within": 120},
		{"do": "wait_frames", "frames": 70},
		{"do": "screenshot", "name": "warp_t1_06_false_chant_w1_07", "target": "window"},
		{"do": "assert", "id": "sector/warp", "prop": "warp_novel", "lte": 3},
		{"do": "set_setting", "key": "photosensitivity", "value": true},
		{"do": "wait_frames", "frames": 10},
		{"do": "screenshot", "name": "warp_t1_07_photosensitive", "target": "window"},
		{"do": "set_setting", "key": "photosensitivity", "value": false},
		{"do": "set_setting", "key": "steady_ledger", "value": true},
		{"do": "wait_frames", "frames": 10},
		{"do": "screenshot", "name": "warp_t1_08_steady_ledger_tier_plate", "target": "window"},
		{"do": "quit"}
	]
}
