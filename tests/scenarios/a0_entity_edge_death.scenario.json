{
	"format": "darkstar.scenario",
	"version": 1,
	"id": "a0_entity_edge_death",
	"args": [],
	"timeout_frames": 1200,
	"steps": [
		{"do": "wait_route", "route": "attract", "within": 120},
		{"do": "coin"},
		{"do": "wait_until", "id": "attract/ui/NewVigil", "prop": "enabled", "eq": true, "within": 240},
		{"do": "activate", "id": "attract/ui/NewVigil"},
		{"do": "wait_route", "route": "cabinet", "within": 240},
		{"do": "set_stage", "index": 3},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "briefing", "within": 600},
		{"do": "wait_frames", "frames": 30},
		{"do": "hold", "action": "fire_lance", "frames": 3},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "play", "within": 600},
		{"do": "kill_all"},
		{"do": "set_lives", "lives": 3},
		{"do": "wake_entity"},
		{"do": "wait_until", "id": "cabinet/world", "prop": "entity_awake", "eq": true, "within": 400},
		{"do": "wait_until", "id": "cabinet/vigil", "prop": "shield", "lte": 0, "within": 240},
		{"do": "place_entity", "dx": 0, "dy": -28},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "dead", "within": 120},
		{"do": "screenshot", "name": "entity_00", "target": "arcade"},
		{"do": "wait_frames", "frames": 6},
		{"do": "screenshot", "name": "entity_06", "target": "arcade"},
		{"do": "wait_frames", "frames": 10},
		{"do": "screenshot", "name": "entity_16", "target": "arcade"},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "entity_36", "target": "arcade"},
		{"do": "wait_frames", "frames": 40},
		{"do": "screenshot", "name": "entity_76", "target": "arcade"},
		{"do": "screenshot", "name": "entity_window", "target": "window"},
		{"do": "assert", "id": "cabinet/vigil", "prop": "killer_kind", "eq": "entity"},
		{"do": "assert", "id": "cabinet/world", "prop": "death_marks", "gte": 1},
		{"do": "snapshot", "name": "after_death"},
		{"do": "quit"}
	]
}
