{
	"format": "darkstar.scenario",
	"version": 1,
	"id": "a0_offview_killer",
	"args": [],
	"timeout_frames": 1200,
	"steps": [
		{"do": "wait_route", "route": "attract", "within": 120},
		{"do": "coin"},
		{"do": "wait_until", "id": "attract/ui/NewVigil", "prop": "enabled", "eq": true, "within": 240},
		{"do": "activate", "id": "attract/ui/NewVigil"},
		{"do": "wait_route", "route": "cabinet", "within": 240},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "play", "within": 600},
		{"do": "kill_all"},
		{"do": "set_lives", "lives": 3},
		{"do": "wait_until", "id": "cabinet/vigil", "prop": "shield", "lte": 0, "within": 240},
		{"do": "spawn", "kind": "acolyte", "dx": 0, "dy": -450},
		{"do": "shoot_vigil", "dx": 0, "dy": -450, "acolyte_id": "last"},
		{"do": "assert", "id": "cabinet/world", "prop": "hostile_shots", "gte": 1},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "dead", "within": 400},
		{"do": "screenshot", "name": "offview_00", "target": "arcade"},
		{"do": "wait_frames", "frames": 6},
		{"do": "screenshot", "name": "offview_06", "target": "arcade"},
		{"do": "wait_frames", "frames": 10},
		{"do": "screenshot", "name": "offview_16", "target": "arcade"},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "offview_36", "target": "arcade"},
		{"do": "wait_frames", "frames": 40},
		{"do": "screenshot", "name": "offview_76", "target": "arcade"},
		{"do": "screenshot", "name": "offview_window", "target": "window"},
		{"do": "assert", "id": "cabinet/world", "prop": "acolytes", "eq": 1},
		{"do": "assert", "id": "cabinet/vigil", "prop": "killer_kind", "eq": "shot"},
		{"do": "assert", "id": "cabinet/vigil", "prop": "shooter_id", "gte": 0},
		{"do": "assert", "id": "cabinet/vigil", "prop": "shooter_alive", "eq": true},
		{"do": "assert", "id": "cabinet/vigil", "prop": "shooter_on_screen", "eq": false},
		{"do": "assert", "id": "cabinet/world", "prop": "death_marks", "gte": 1},
		{"do": "snapshot", "name": "after_death"},
		{"do": "quit"}
	]
}
