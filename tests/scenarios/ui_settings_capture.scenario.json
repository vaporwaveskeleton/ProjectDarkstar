{
	"format": "darkstar.scenario",
	"version": 1,
	"id": "ui_settings_capture",
	"profile": "dev",
	"args": [],
	"fixtures": {},
	"timeout_frames": 1200,
	"steps": [
		{"do": "wait_route", "route": "attract", "within": 240},
		{"do": "coin"},
		{"do": "activate", "id": "attract/ui/Settings"},
		{"do": "wait_until", "id": "attract/ui/Back", "prop": "visible", "eq": true, "within": 120},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "settings_attract_default", "target": "window"},
		{"do": "snapshot", "name": "settings_attract_default"},
		{"do": "activate", "id": "attract/ui/LargeText"},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "settings_attract_large_text", "target": "window"},
		{"do": "activate", "id": "attract/ui/ReducedMotion"},
		{"do": "activate", "id": "attract/ui/Photosensitivity"},
		{"do": "activate", "id": "attract/ui/SteadyLedger"},
		{"do": "activate", "id": "attract/ui/MuzzleFlash"},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "settings_attract_all_toggled", "target": "window"},
		{"do": "snapshot", "name": "settings_attract_all_toggled"},
		{"do": "cancel"},
		{"do": "wait_until", "id": "attract/ui/Settings", "prop": "focused", "eq": true, "within": 120},
		{"do": "goto", "route": "sector"},
		{"do": "wait_route", "route": "sector", "within": 600},
		{"do": "wait_frames", "frames": 30},
		{"do": "hold", "action": "pause", "frames": 2},
		{"do": "wait_until", "id": "sector/ui/Settings", "prop": "visible", "eq": true, "within": 120},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "pause_sector", "target": "window"},
		{"do": "activate", "id": "sector/ui/Settings"},
		{"do": "wait_until", "id": "sector/ui/Back", "prop": "visible", "eq": true, "within": 120},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "settings_from_pause", "target": "window"},
		{"do": "snapshot", "name": "settings_from_pause"},
		{"do": "cancel"},
		{"do": "wait_until", "id": "sector/ui/Settings", "prop": "focused", "eq": true, "within": 120},
		{"do": "quit"}
	]
}
