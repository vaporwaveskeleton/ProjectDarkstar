{
	"format": "darkstar.scenario",
	"version": 1,
	"id": "ui_audio_capture",
	"profile": "dev",
	"args": [],
	"fixtures": {},
	"timeout_frames": 900,
	"steps": [
		{"do": "wait_route", "route": "attract", "within": 240},
		{"do": "coin"},
		{"do": "activate", "id": "attract/ui/Settings"},
		{"do": "wait_until", "id": "attract/ui/Back", "prop": "visible", "eq": true, "within": 120},
		{"do": "focus", "id": "attract/ui/TabAudio"},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "audio_act0", "target": "window"},
		{"do": "focus", "id": "attract/ui/VolMusic"},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "audio_act0_slider_focus", "target": "window"},
		{"do": "set_setting", "key": "text_scale", "value": 2.0},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "audio_act0_large_text", "target": "window"},
		{"do": "set_setting", "key": "text_scale", "value": 1.0},
		{"do": "cancel"},
		{"do": "goto", "route": "sector"},
		{"do": "wait_route", "route": "sector", "within": 600},
		{"do": "wait_frames", "frames": 30},
		{"do": "hold", "action": "pause", "frames": 2},
		{"do": "wait_until", "id": "sector/ui/Settings", "prop": "visible", "eq": true, "within": 120},
		{"do": "activate", "id": "sector/ui/Settings"},
		{"do": "wait_until", "id": "sector/ui/Back", "prop": "visible", "eq": true, "within": 120},
		{"do": "focus", "id": "sector/ui/TabAudio"},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "audio_aether", "target": "window"},
		{"do": "focus", "id": "sector/ui/VolEntity"},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "audio_aether_slider_focus", "target": "window"},
		{"do": "set_setting", "key": "text_scale", "value": 2.0},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "audio_aether_large_text", "target": "window"},
		{"do": "set_setting", "key": "text_scale", "value": 1.0},
		{"do": "cancel"},
		{"do": "quit"}
	]
}
