{
	"format": "darkstar.scenario",
	"version": 1,
	"id": "a0_stage_3_censer_watch",
	"args": [],
	"timeout_frames": 1200,
	"steps": [
		{"do": "wait_route", "route": "attract", "within": 120},
		{"do": "coin"},
		{"do": "wait_until", "id": "attract/ui/NewVigil", "prop": "enabled", "eq": true, "within": 240},
		{"do": "activate", "id": "attract/ui/NewVigil"},
		{"do": "wait_route", "route": "cabinet", "within": 240},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "briefing", "within": 600},
		{"do": "wait_frames", "frames": 30},
		{"do": "hold", "action": "fire_lance", "frames": 3},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "play", "within": 600},
		{"do": "set_stage", "index": 1},
		{"do": "wait_until", "id": "cabinet/game", "prop": "stage_index", "eq": 1, "within": 10},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "briefing", "within": 10},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "stage_3_brief", "target": "arcade"},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "briefing", "within": 600},
		{"do": "wait_frames", "frames": 30},
		{"do": "hold", "action": "fire_lance", "frames": 3},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "intro", "within": 60},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "stage_3_ready", "target": "arcade"},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "play", "within": 600},
		{"do": "assert", "id": "cabinet/game", "prop": "stage_index", "eq": 1},
		{"do": "assert", "id": "cabinet/game", "prop": "stage_id", "eq": "a0_3"},
		{"do": "assert", "id": "cabinet/world", "prop": "geodes", "eq": 44},
		{"do": "assert", "id": "cabinet/world", "prop": "grubs", "eq": 14},
		{"do": "assert", "id": "cabinet/world", "prop": "acolytes", "eq": 5},
		{"do": "assert", "id": "cabinet/world", "prop": "entity_awake", "eq": false},
		{"do": "wake_entity"},
		{"do": "wait_until", "id": "cabinet/world", "prop": "entity_awake", "eq": true, "within": 600},
		{"do": "screenshot", "name": "stage_3_awake", "target": "arcade"},
		{"do": "wait_frames", "frames": 30},
		{"do": "screenshot", "name": "stage_3_play", "target": "arcade"},
		{"do": "screenshot", "name": "stage_3_window", "target": "window"},
		{"do": "snapshot", "name": "stage_3"},
		{"do": "quit"}
	]
}
