{
	"format": "darkstar.scenario",
	"version": 1,
	"id": "a1_golden_path",
	"profile": "dev",
	"args": [
		"--segments=20",
		"--hits=1"
	],
	"fixtures": {},
	"fail_on_errors": true,
	"timeout_frames": 150000,
	"steps": [
		{"do": "wait_route", "route": "attract", "within": 240},
		{"do": "coin"},
		{"do": "wait_until", "id": "attract/ui/NewVigil", "prop": "enabled", "eq": true, "within": 240},
		{"do": "screenshot", "name": "01_attract_credited", "target": "window"},
		{"do": "activate", "id": "attract/ui/NewVigil"},
		{"do": "wait_route", "route": "cabinet", "within": 240},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "play", "within": 600},
		{"do": "autopilot", "on": true},
		{"do": "wait_until", "id": "cabinet/game", "prop": "stage_index", "eq": 1, "within": 30000},
		{"do": "wait_until", "id": "cabinet/game", "prop": "stage_index", "eq": 2, "within": 30000},
		{"do": "wait_until", "id": "cabinet/game", "prop": "stage_index", "eq": 3, "within": 30000},
		{"do": "wait_until", "id": "cabinet/game", "prop": "stage_index", "eq": 4, "within": 30000},
		{"do": "wait_frames", "frames": 120},
		{"do": "screenshot", "name": "02_act0_play", "target": "window"},
		{"do": "snapshot", "name": "last_stage"},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "reveal", "within": 40000},
		{"do": "assert", "id": "run/session", "prop": "act0_banked", "eq": false},
		{"do": "wait_frames", "frames": 200},
		{"do": "screenshot", "name": "03_reveal_pretence", "target": "window"},
		{"do": "wait_route", "route": "aether", "within": 1800},
		{"do": "wait_frames", "frames": 30},
		{"do": "screenshot", "name": "04_unmaking_tear", "target": "window"},
		{"do": "wait_frames", "frames": 3000},
		{"do": "screenshot", "name": "05_unmaking_front", "target": "window"},
		{"do": "wait_route", "route": "ruins", "within": 3000},
		{"do": "wait_until", "id": "run/session", "prop": "act0_banked", "eq": true, "within": 120},
		{"do": "assert", "id": "run/session", "prop": "ember", "gt": 0},
		{"do": "wait_frames", "frames": 200},
		{"do": "screenshot", "name": "06_ruins", "target": "window"},
		{"do": "wait_until", "id": "ruins/onboarding", "prop": "tickets_landed", "eq": true, "within": 1200},
		{"do": "assert", "id": "ruins/onboarding", "prop": "gate_open", "eq": false},
		{"do": "hold", "action": "move_right", "frames": 64},
		{"do": "wait_until", "id": "ruins/onboarding", "prop": "focus_id", "eq": "tree", "within": 30},
		{"do": "hold", "action": "ui_accept", "frames": 2},
		{"do": "wait_until", "id": "ruins/onboarding", "prop": "gate_open", "eq": true, "within": 30},
		{"do": "press", "action": "move_right"},
		{"do": "wait_route", "route": "sector", "within": 600},
		{"do": "release", "action": "move_right"},
		{"do": "assert", "id": "sector/run", "prop": "run_session", "eq": true},
		{"do": "assert", "id": "sector/run", "prop": "seam_index", "eq": 1},
		{"do": "assert", "id": "sector/run", "prop": "far_look", "eq": "ds_aether.pm01_pale_marches_t1"},
		{"do": "assert", "id": "run/session", "prop": "seam_index", "eq": 1},
		{"do": "hold", "action": "move_right", "frames": 90},
		{"do": "screenshot", "name": "07_pm01_sector", "target": "window"},
		{"do": "quit"}
	]
}