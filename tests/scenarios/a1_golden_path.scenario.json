		{"do": "wait_frames", "frames": 60},
		{"do": "screenshot", "name": "03_reveal_seq_0480", "target": "window"},
		{"do": "wait_frames", "frames": 60},
		{"do": "screenshot", "name": "03_reveal_seq_0540", "target": "window"},
		{"do": "wait_frames", "frames": 60},
