		{"do": "wait_frames", "frames": 60},
		{"do": "screenshot", "name": "03_reveal_seq_0720", "target": "window"},
		{"do": "wait_frames", "frames": 30},
		{"do": "screenshot", "name": "03_decay_dot", "target": "window"},
		{"do": "wait_frames", "frames": 30},
		{"do": "screenshot", "name": "03_reveal_seq_0780", "target": "window"},
