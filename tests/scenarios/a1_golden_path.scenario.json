		{"do": "wait_frames", "frames": 30},
		{"do": "screenshot", "name": "04_unmaking_tear", "target": "window"},
		{"do": "wait_frames", "frames": 3000},
		{"do": "screenshot", "name": "05_unmaking_front", "target": "window"},
		{"do": "wait_route", "route": "ruins", "within": 3000},
		{"do": "wait_until", "id": "run/session", "prop": "act0_banked", "eq": true, "within": 120},
