{
	"format": "darkstar.scenario",
	"version": 1,
	"profile": "dev",
	"args": ["--segments=20", "--hits=1"],
	"fixtures": {},
	"timeout_frames": 150000,
	"id": "perf_golden_path",
	"steps": [
		{"do": "wait_route", "route": "attract", "within": 240},
		{"do": "coin"},
		{"do": "wait_until", "id": "attract/ui/NewVigil", "prop": "enabled", "eq": true, "within": 240},
		{"do": "activate", "id": "attract/ui/NewVigil"},
		{"do": "wait_route", "route": "cabinet", "within": 240},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "play", "within": 600},
		{"do": "autopilot", "on": true},
		{"do": "set_lives", "lives": 9},
		{"do": "wait_until", "id": "cabinet/game", "prop": "stage_index", "eq": 1, "within": 30000},
		{"do": "set_lives", "lives": 9},
		{"do": "wait_until", "id": "cabinet/game", "prop": "stage_index", "eq": 2, "within": 30000},
		{"do": "set_lives", "lives": 9},
		{"do": "wait_until", "id": "cabinet/game", "prop": "stage_index", "eq": 3, "within": 30000},
		{"do": "set_lives", "lives": 9},
		{"do": "wait_until", "id": "cabinet/game", "prop": "stage_index", "eq": 4, "within": 30000},
		{"do": "set_lives", "lives": 9},
		{"do": "perf_begin", "name": "act0_stage4"},
		{"do": "wait_frames", "frames": 600},
		{"do": "perf_end", "name": "act0_stage4", "budget_ms": 8},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "reveal", "within": 40000},
		{"do": "perf_begin", "name": "reveal"},
		{"do": "wait_route", "route": "aether", "within": 1800},
		{"do": "perf_end", "name": "reveal", "budget_ms": 8},
		{"do": "perf_begin", "name": "unmaking"},
		{"do": "wait_frames", "frames": 30},
		{"do": "wait_route", "route": "ruins", "within": 7200},
		{"do": "perf_end", "name": "unmaking", "budget_ms": 8},
		{"do": "perf_begin", "name": "ruins"},
		{"do": "wait_frames", "frames": 200},
		{"do": "perf_end", "name": "ruins", "budget_ms": 8},
		{"do": "hold", "action": "ui_accept", "frames": 2},
		{"do": "wait_route", "route": "sector", "within": 600},
		{"do": "assert", "id": "sector/run", "prop": "seam_index", "eq": 1},
		{"do": "perf_begin", "name": "pm01_sector"},
		{"do": "hold", "action": "move_right", "frames": 300},
		{"do": "hold", "action": "move_left", "frames": 300},
		{"do": "perf_end", "name": "pm01_sector", "budget_ms": 8},
		{"do": "quit"}
	]
}
