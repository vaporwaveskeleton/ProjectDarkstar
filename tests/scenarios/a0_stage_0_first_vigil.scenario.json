{
	"format": "darkstar.scenario",
	"version": 1,
	"id": "a0_stage_0_first_vigil",
	"args": [],
	"timeout_frames": 1200,
	"steps": [
		{"do": "wait_route", "route": "attract", "within": 120},
		{"do": "coin"},
		{"do": "wait_until", "id": "attract/ui/NewVigil", "prop": "enabled", "eq": true, "within": 240},
		{"do": "activate", "id": "attract/ui/NewVigil"},
		{"do": "wait_route", "route": "cabinet", "within": 240},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "play", "within": 600},
		{"do": "set_stage", "index": 0},
		{"do": "wait_until", "id": "cabinet/game", "prop": "stage_index", "eq": 0, "within": 10},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "intro", "within": 10},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "stage_0_ready", "target": "arcade"},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "play", "within": 600},
		{"do": "assert", "id": "cabinet/game", "prop": "stage_index", "eq": 0},
		{"do": "assert", "id": "cabinet/game", "prop": "stage_id", "eq": "a0_1"},
		{"do": "assert", "id": "cabinet/world", "prop": "geodes", "eq": 12},
		{"do": "assert", "id": "cabinet/world", "prop": "grubs", "eq": 2},
		{"do": "assert", "id": "cabinet/world", "prop": "acolytes", "eq": 0},
		{"do": "assert", "id": "cabinet/world", "prop": "entity_awake", "eq": false},
		{"do": "wait_frames", "frames": 30},
		{"do": "screenshot", "name": "stage_0_play", "target": "arcade"},
		{"do": "screenshot", "name": "stage_0_window", "target": "window"},
		{"do": "snapshot", "name": "stage_0"},
		{"do": "quit"}
	]
}
