{
	"format": "darkstar.scenario",
	"version": 1,
	"id": "a1_run_loop",
	"profile": "qa",
	"args": [
		"--clear-knocks=1",
		"--sepulchre-start=1"
	],
	"fixtures": {"profile": "profile_act0_done"},
	"fail_on_errors": true,
	"timeout_frames": 12000,
	"steps": [
		{"do": "wait_route", "route": "attract", "within": 240},
		{"do": "goto", "route": "ruins"},
		{"do": "wait_route", "route": "ruins", "within": 240},
		{"do": "assert", "id": "ruins/onboarding", "prop": "first_visit", "eq": true},
		{"do": "wait_until", "id": "ruins/onboarding", "prop": "tickets_landed", "eq": true, "within": 1500},
		{"do": "hold", "action": "move_right", "frames": 64},
		{"do": "wait_until", "id": "ruins/onboarding", "prop": "focus_id", "eq": "tree", "within": 30},
		{"do": "hold", "action": "ui_accept", "frames": 2},
		{"do": "wait_until", "id": "ruins/onboarding", "prop": "gate_open", "eq": true, "within": 30},
		{"do": "assert", "id": "ruins/onboarding", "prop": "tree_open", "eq": false},
		{"do": "assert", "id": "run/session", "prop": "tree_owned", "eq": 1},
		{"do": "assert", "id": "run/session", "prop": "ember", "eq": 20},
		{"do": "assert", "id": "run/session", "prop": "codex_known", "eq": 1},
		{"do": "assert", "id": "run/session", "prop": "runs_ended", "eq": 0},
		{"do": "press", "action": "move_right"},
		{"do": "wait_route", "route": "sector", "within": 600},
		{"do": "release", "action": "move_right"},
		{"do": "assert", "id": "sector/run", "prop": "run_session", "eq": true},
		{"do": "assert", "id": "run/session", "prop": "seam_index", "eq": 1},
		{"do": "assert", "id": "sector/choir", "prop": "segments", "eq": 1},
		{"do": "assert", "id": "sector/run", "prop": "seam_cleared", "eq": false},
		{"do": "press", "action": "aim_right"},
		{"do": "wait_frames", "frames": 10},
		{"do": "press", "action": "fire_lance"},
		{"do": "wait_until", "id": "sector/field", "prop": "geodes_alive", "lt": 10, "within": 300},
		{"do": "release", "action": "fire_lance"},
		{"do": "release", "action": "aim_right"},
		{"do": "hold", "action": "move_right", "frames": 30},
		{"do": "wait_until", "id": "sector/field", "prop": "charges", "gte": 1, "within": 300},
		{"do": "hold", "action": "move_down", "frames": 40},
		{"do": "wait_frames", "frames": 30},
		{"do": "mouse_move", "x": 632, "y": 350},
		{"do": "wait_frames", "frames": 4},
		{"do": "mouse_button", "button": "right", "pressed": true},
		{"do": "wait_frames", "frames": 2},
		{"do": "mouse_button", "button": "right", "pressed": false},
		{"do": "wait_until", "id": "sector/field", "prop": "charges_hit", "gte": 1, "within": 420},
		{"do": "wait_until", "id": "sector/run", "prop": "seam_cleared", "eq": true, "within": 30},
		{"do": "assert", "id": "sector/run", "prop": "throat_dy", "lt": 0},
		{"do": "assert", "id": "sector/run", "prop": "throat_dx", "lt": 0},
		{"do": "press", "action": "move_up"},
		{"do": "wait_until", "id": "sector/run", "prop": "throat_dy", "gte": -15, "within": 300},
		{"do": "release", "action": "move_up"},
		{"do": "hold", "action": "brake", "frames": 20},
		{"do": "press", "action": "move_left"},
		{"do": "wait_until", "id": "sector/run", "prop": "exit_taken", "eq": true, "within": 900},
		{"do": "release", "action": "move_left"},
		{"do": "assert", "id": "run/session", "prop": "run_active", "eq": false},
		{"do": "wait_route", "route": "ruins", "within": 600},
		{"do": "assert", "id": "ruins/onboarding", "prop": "first_visit", "eq": false},
		{"do": "assert", "id": "ruins/onboarding", "prop": "return_outcome", "eq": "returned"},
		{"do": "assert", "id": "run/session", "prop": "ember", "gte": 60},
		{"do": "assert", "id": "run/session", "prop": "runs_ended", "eq": 1},
		{"do": "assert", "id": "run/session", "prop": "tree_owned", "eq": 1},
		{"do": "wait_frames", "frames": 30},
		{"do": "assert", "id": "run/session", "prop": "clock_paused", "eq": false},
		{"do": "hold", "action": "move_right", "frames": 64},
		{"do": "wait_until", "id": "ruins/onboarding", "prop": "focus_id", "eq": "tree", "within": 30},
		{"do": "hold", "action": "ui_accept", "frames": 2},
		{"do": "wait_until", "id": "ruins/onboarding", "prop": "tree_open", "eq": true, "within": 30},
		{"do": "activate", "id": "ruins/ui/Lamp_HULL_1"},
		{"do": "activate", "id": "ruins/ui/ConfirmLight"},
		{"do": "cancel"},
		{"do": "wait_until", "id": "run/session", "prop": "tree_owned", "eq": 2, "within": 30},
		{"do": "assert", "id": "run/session", "prop": "ember", "gte": 20},
		{"do": "assert", "id": "ruins/onboarding", "prop": "gate_open", "eq": true},
		{"do": "press", "action": "move_right"},
		{"do": "wait_route", "route": "sector", "within": 600},
		{"do": "release", "action": "move_right"},
		{"do": "assert", "id": "sector/run", "prop": "run_session", "eq": true},
		{"do": "assert", "id": "run/session", "prop": "run_active", "eq": true},
		{"do": "assert", "id": "run/session", "prop": "seam_index", "eq": 1},
		{"do": "assert", "id": "sector/run", "prop": "seam_cleared", "eq": false},
		{"do": "wait_frames", "frames": 30},
		{"do": "quit"}
	]
}
