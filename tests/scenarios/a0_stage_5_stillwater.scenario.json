		{"do": "assert", "id": "cabinet/game", "prop": "stage_index", "eq": 2},
		{"do": "assert", "id": "cabinet/game", "prop": "stage_id", "eq": "a0_5"},
		{"do": "assert", "id": "cabinet/world", "prop": "geodes", "eq": 14},
