		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "play", "within": 600},
		{"do": "set_stage", "index": 2},
		{"do": "wait_until", "id": "cabinet/game", "prop": "stage_index", "eq": 2, "within": 10},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "briefing", "within": 10},
		{"do": "wait_frames", "frames": 20},
		{"do": "screenshot", "name": "stage_5_brief", "target": "arcade"},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "briefing", "within": 600},
		{"do": "wait_frames", "frames": 30},
		{"do": "hold", "action": "fire_lance", "frames": 3},
		{"do": "wait_until", "id": "cabinet/game", "prop": "state", "eq": "intro", "within": 60},
		{"do": "wait_frames", "frames": 20},
