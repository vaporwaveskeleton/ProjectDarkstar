{
	"format": "darkstar.scenario",
	"version": 1,
	"id": "m1_overfire",
	"profile": "qa",
	"args": [],
	"fixtures": {},
	"timeout_frames": 1200,
	"steps": [
		{"do": "wait_route", "route": "attract", "within": 120},
		{"do": "goto", "route": "sector"},
		{"do": "wait_route", "route": "sector", "within": 240},
		{"do": "assert", "id": "sector/field", "prop": "geodes_alive", "eq": 10},
		{"do": "assert", "id": "sector/field", "prop": "geodes_detonated", "eq": 0},
		{"do": "hold", "action": "move_up", "frames": 2},
		{"do": "wait_frames", "frames": 120},
		{"do": "assert", "id": "sector/vigil", "prop": "vigil_y", "lt": 165},
		{"do": "assert", "id": "sector/vigil", "prop": "vigil_y", "gt": 135},
		{"do": "press", "action": "aim_right"},
		{"do": "wait_frames", "frames": 10},
		{"do": "press", "action": "fire_lance"},
		{"do": "wait_until", "id": "sector/field", "prop": "geodes_detonated", "eq": 1, "within": 240},
		{"do": "release", "action": "fire_lance"},
		{"do": "checkpoint", "name": "geode_detonated"},
		{"do": "assert", "id": "sector/field", "prop": "geodes_alive", "eq": 9},
		{"do": "assert", "id": "sector/field", "prop": "shards_free", "gte": 4},
		{"do": "screenshot", "name": "geode_detonated", "target": "window"},
		{"do": "quit"}
	]
}
