[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scenes/sector/pause_screen.gd" id="1"]
[ext_resource type="Script" path="res://core/ui/fit_scroll_container.gd" id="fit"]
[ext_resource type="Script" path="res://core/ui/menu_frame.gd" id="frame"]
[ext_resource type="Script" path="res://core/ui/menu_text.gd" id="text"]
[ext_resource type="Script" path="res://core/ui/menu_rule.gd" id="rule"]
[ext_resource type="Script" path="res://core/ui/menu_row.gd" id="row"]
[ext_resource type="Script" path="res://core/ui/menu_ornament.gd" id="orn"]

[node name="PauseScreen" type="Control" node_paths=PackedStringArray("default_focus")]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")
default_focus = NodePath("Center/Panel/Layout/Body/Scroll/Rows/Resume")

[node name="Dim" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"DimPanel"

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2
script = ExtResource("frame")

[node name="Layout" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Control" parent="Center/Panel/Layout"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("text")
key = &"PAUSE_TITLE"
role = 0

[node name="HeaderRule" type="Control" parent="Center/Panel/Layout"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("rule")
heavy = true

[node name="Body" type="HBoxContainer" parent="Center/Panel/Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Ornament" type="Control" parent="Center/Panel/Layout/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
script = ExtResource("orn")
base_min = Vector2(84, 84)

[node name="Divider" type="Control" parent="Center/Panel/Layout/Body"]
layout_mode = 2
script = ExtResource("rule")
vertical = true

[node name="Scroll" type="ScrollContainer" parent="Center/Panel/Layout/Body" node_paths=PackedStringArray("also_reserve")]
layout_mode = 2
size_flags_vertical = 4
script = ExtResource("fit")
also_reserve = [NodePath("../../Title"), NodePath("../../HeaderRule")]

[node name="Rows" type="VBoxContainer" parent="Center/Panel/Layout/Body/Scroll"]
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
theme_override_constants/separation = 3

[node name="Resume" type="BaseButton" parent="Center/Panel/Layout/Body/Scroll/Rows"]
unique_name_in_owner = true
layout_mode = 2
