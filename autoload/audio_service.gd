extends Node
## AudioService (autoload) — why global: sound must survive scene changes and one owner must
## enforce the silence budget and the chant bed (AUDIO-001 §1.4, §5, §7). TECH-001 §2.8.
## Every sound is generated by code (GDD-001 D-14, amended 2026-11-18; AUDIO-001 §11). A cue plays the
## chirp render of its id (`res://assets/audio/generated/sfx/<id>.wav`, built from `audio/src/*.cx.js`)
## when one exists, else the runtime SfxSynth version (built lazily, only when a render is missing);
## continuous morphs stay runtime-synthesised. Cue ids come from `data/audio/cue_ids.tres`.
## Voice policy (bus, priority, concurrency, retrigger gate, pitch jitter) comes from
## `data/audio/cue_policy.tres` (AUDIO-001 §12.6). Gameplay never decides mixing: it asks for a
## cue, the chant level, or a silence.

const VOICES := 24                     ## ✱ one-shot voice pool
const CHANT_MAX_DB := -14.0            ## ✱ chant bed level at full build
const AMBIENCE_FADE_S := 2.0           ## ✱ ambience crossfade / fade-in time; must stay >= 0.6 s (AUDIO-001 §1.4 bed-return rule)
const AMBIENCE_MAX_DB := -12.0         ## ✱ ambience bed level at level 1.0
const CHIRP_DIR := "res://assets/audio/generated/sfx"   ## chirp build output (AUDIO-001 §11.7)
const SYNTH_TRIM_DB := -6.0            ## ✱ runtime-synth cues run hotter than the chirp renders
const BED_PITCH_FALL_S := 0.15         ## ✱ full-range glide time going down (slow-mo in)
const BED_PITCH_RISE_S := 0.35         ## ✱ full-range glide time going up (slow-mo out)
const BED_PITCH_MIN := 0.25            ## ✱ safety clamp (engine minimum is 0.01)
const CUE_IDS_PATH := "res://data/audio/cue_ids.tres"
const CUE_POLICY_PATH := "res://data/audio/cue_policy.tres"
const SHUTDOWN_DRAIN_MS := 100   ## ✱ wait for the mixer to free stopped playbacks at exit
const UNSTEALABLE_BELOW := 2           ## P0 and P1 are never stolen (AUDIO-001 §12.6)
const SUBTRACTION_OPEN_HZ := 20000.0   ## ✱ low-pass cutoff at subtraction 0 (the Passing / Waking lanes, AUDIO-001 §12.14)
const SUBTRACTION_CLOSED_HZ := 500.0   ## ✱ low-pass cutoff at subtraction 1
const SUBTRACTION_CUT_DB := -18.0      ## ✱ BUS-AMB / BUS-MUS volume offset at subtraction 1
const SUBTRACTION_BUSES: Array[StringName] = [&"BUS-AMB", &"BUS-MUS"]   ## the only buses sound is removed from (L3)
const MIX_STATS_PATH := "res://data/audio/mix_stats.tres"
## Buses the §7.2 sidechain may duck. BUS-CHO and BUS-ENT are never ducked (§7.3).
const DUCK_BUSES: Array[StringName] = [&"BUS-MUS", &"BUS-AMB", &"BUS-UI", &"BUS-FLY"]
## AUDIO-001 §7.2: the buses a sounding cue of each priority ducks (depths in AudioMixStats).
const DUCK_TARGETS := {
	0: [&"BUS-MUS", &"BUS-AMB", &"BUS-UI", &"BUS-FLY"],
	1: [&"BUS-MUS", &"BUS-AMB", &"BUS-UI"],
	2: [&"BUS-MUS"],
	3: [&"BUS-MUS", &"BUS-AMB"],
	4: [&"BUS-MUS"],
	5: [&"BUS-AMB"],
}
## A bus carrying a sounding cue at this priority or more important is never ducked (§7.3: the glass
## chime, hull damage, the lie-tell ticks are never hidden).
const DUCK_PROTECT_BELOW := 2
const FLIGHT_CREAK := &"flight_creak"
const FLIGHT_BALLAST := &"flight_ballast"
const MAX_THREAT_STEMS := 2

var cue_ids: CueIds
var policy: CuePolicy
## Ducking, flight-layer and threat-stem tunables (AUDIO-001 §7.2, §12.18).
var mix: AudioMixStats
## Cues built by the runtime SfxSynth fallback at boot (0 when every render exists).
var synth_cue_count := 0
## Tests set this (>= 0) to drive the clock, in ms; -1 uses Time.get_ticks_msec().
var now_ms_override := -1

var _cues: Dictionary = {}             # StringName -> AudioStream
var _trim: Dictionary = {}             # StringName -> dB offset per cue (0 for chirp renders)
var _rendered: Dictionary = {}         # StringName -> true when the cue plays a chirp render
var _voices: Array[AudioStreamPlayer] = []
var _voice_cue: Array[StringName] = []
var _voice_priority: Array[int] = []
var _voice_start_ms: Array[int] = []
var _voice_end_ms: Array[int] = []     # a voice is busy while now < end (0 = free)
var _last_start_ms: Dictionary = {}    # StringName -> int
var _jitter_rng := RandomNumberGenerator.new()   # cosmetic only; never the seeded run RNG
var _chant: AudioStreamPlayer
var _chant_level := 0.0
var _beds: Dictionary = {}             # StringName -> AudioStream (loop cues except the chant; ambience slot only)
var _amb: Array[AudioStreamPlayer] = []   # A/B crossfade pair on BUS-AMB
var _amb_fade: Array[float] = [0.0, 0.0]  # per-player fade position 0..1 (equal-power gain = sin(f * PI/2))
var _amb_active := 0
var _amb_id: StringName = &""
var _amb_level := 1.0
var _amb_level_cur := 1.0
var _silence := 0.0
var _bed_pitch_target := 1.0
var muted_for_tests := false
var _sub_cur := 0.0
var _sub_from := 0.0
var _sub_target := 0.0
var _sub_ramp_s := 0.0
var _sub_t := 0.0
var _sub_fx: Dictionary = {}           # StringName bus -> AudioEffectLowPassFilter index on that bus
var _touch_ms := -1000000              # wall-clock ms of the last playback start or stop (shutdown drain)
var _bus_base_db: Dictionary = {}      # StringName bus -> volume_db before subtraction and ducking
var _duck_cur: Dictionary = {}         # StringName bus -> current duck offset, dB (<= 0)
var _flight_streams: Dictionary = {}   # StringName layer -> AudioStream (FlightMix.LAYERS)
var _flight: Dictionary = {}           # StringName layer -> AudioStreamPlayer on BUS-FLY
var _flight_db: Dictionary = {}        # StringName layer -> smoothed volume_db
var _flight_pitch: Dictionary = {}     # StringName layer -> smoothed pitch_scale
var _flight_on := false
var _flight_in := Vector3.ZERO         # speed, thrust, turn (0..1)
var _flight_return := 1.0              # 0..1 return ramp after a silence
var _creak_armed := true
var _was_braking := false
var _stems: Array[AudioStreamPlayer] = []   # threat stems, locked to the active bed's playhead
var _stem_ids: Array[StringName] = []
var _threat := 0.0
var _threat_cur := 0.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_jitter_rng.randomize()
	if cue_ids == null:
		cue_ids = load(CUE_IDS_PATH) as CueIds
		if cue_ids == null:
			cue_ids = CueIds.new()
	if policy == null:
		policy = load(CUE_POLICY_PATH) as CuePolicy
		if policy == null:
			policy = CuePolicy.new()
	if mix == null:
		mix = load(MIX_STATS_PATH) as AudioMixStats
		if mix == null:
			mix = AudioMixStats.new()
	_load_cues()
	_setup_subtraction()
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = &"BUS-FLY"
		add_child(p)
		_voices.append(p)
		_voice_cue.append(&"")
		_voice_priority.append(CuePolicy.DEFAULT_PRIORITY)
		_voice_start_ms.append(0)
		_voice_end_ms.append(0)
	_chant = AudioStreamPlayer.new()
	_chant.bus = &"BUS-CHO"
	var chant := chirp_stream(&"chant")
	_chant.stream = chant if chant != null else SfxSynth.build_chant_loop()
	_chant.volume_db = -80.0
	add_child(_chant)
	for i in 2:
		var a := AudioStreamPlayer.new()
		a.bus = &"BUS-AMB"
		a.volume_db = -80.0
		add_child(a)
		_amb.append(a)
	for i in MAX_THREAT_STEMS:
		var s := AudioStreamPlayer.new()
		s.bus = &"BUS-AMB"
		s.volume_db = -80.0
		add_child(s)
		_stems.append(s)
	for id: StringName in FlightMix.LAYERS:
		if not _flight_streams.has(id):
			continue
		var f := AudioStreamPlayer.new()
		f.bus = &"BUS-FLY"
		f.volume_db = -80.0
		f.stream = _flight_streams[id]
		add_child(f)
		_flight[id] = f
		_flight_db[id] = -80.0
		_flight_pitch[id] = 1.0


## Renders first; the SfxSynth set is built once, and only when a fallback cue lacks its render.
func _load_cues() -> void:
	var missing: Array[StringName] = []
	for e in cue_ids.entries:
		if e.is_loop:
			# loops never enter the one-shot table, so play() cannot start them; the chant has its
			# own player, every other loop is an ambience bed for set_ambience()
			if e.id != &"chant":
				var bed := chirp_stream(e.id)
				if bed != null:
					if e.id in FlightMix.LAYERS:
						_flight_streams[e.id] = bed   # the ship's layers: never an ambience bed
					else:
						_beds[e.id] = bed
			continue
		var rendered := chirp_stream(e.id)
		if rendered != null:
			_cues[e.id] = rendered
			_trim[e.id] = 0.0
			_rendered[e.id] = true
		elif e.has_synth_fallback:
			missing.append(e.id)
	if missing.is_empty():
		return
	var synth := SfxSynth.build_cabinet_set()
	for id in missing:
		if synth.has(id):
			_cues[id] = synth[id]
			_trim[id] = SYNTH_TRIM_DB
			synth_cue_count += 1


## The chirp render for a cue id, or null when none was built.
static func chirp_stream(id: StringName) -> AudioStream:
	var path := "%s/%s.wav" % [CHIRP_DIR, id]
	if not ResourceLoader.exists(path):
		return null
	return load(path) as AudioStream


## True when the cue will play a chirp render (tests, diagnostics).
func uses_chirp(id: StringName) -> bool:
	return _rendered.has(id)


## True when the cue can play at all (a render or a fallback exists).
func has_cue(id: StringName) -> bool:
	return _cues.has(id)


func _touch() -> void:
	_touch_ms = Time.get_ticks_msec()


func _now_ms() -> int:
	return now_ms_override if now_ms_override >= 0 else Time.get_ticks_msec()


## Number of voices currently sounding `id` (any cue when `id` is empty).
func active_count(id: StringName = &"") -> int:
	var now := _now_ms()
	var n := 0
	for i in _voices.size():
		if _voice_end_ms[i] > now and (id == &"" or _voice_cue[i] == id):
			n += 1
	return n


func play(id: StringName, volume_db: float = 0.0) -> void:
	if muted_for_tests or _silence > 0.0 or not _cues.has(id):
		return
	var rule := policy.entry_for(id)
	var now := _now_ms()
	if rule.min_retrigger_ms > 0 and _last_start_ms.has(id):
		var last: int = _last_start_ms[id]
		if now - last < rule.min_retrigger_ms:
			return
	var index := _pick_voice(id, rule, now)
	if index < 0:
		return   # nothing stealable: the new request is dropped
	var p := _voices[index]
	var stream: AudioStream = _cues[id]
	p.stop()
	p.stream = stream
	p.bus = rule.bus
	p.volume_db = volume_db + float(_trim.get(id, SYNTH_TRIM_DB))
	var pitch := 1.0
	if rule.pitch_jitter_cents > 0.0:
		pitch = pow(2.0, _jitter_rng.randf_range(-rule.pitch_jitter_cents, rule.pitch_jitter_cents) / 1200.0)
	p.pitch_scale = pitch
	p.play()
	_touch()
	_voice_cue[index] = id
	_voice_priority[index] = rule.priority
	_voice_start_ms[index] = now
	_voice_end_ms[index] = now + maxi(1, int(ceilf(stream.get_length() * 1000.0 / pitch)))
	_last_start_ms[id] = now


## Voice to use for a new `id`, or -1 to drop the request. Order: a finished voice; the lowest-priority
## stealable voice (P2 or lower, never more important than the new cue; oldest on a tie); when the
## cue is at its own cap, the oldest voice of the same cue id. P0 and P1 are never stolen.
func _pick_voice(id: StringName, rule: CuePolicyEntry, now: int) -> int:
	if rule.max_concurrent > 0 and active_count(id) >= rule.max_concurrent:
		return _oldest_of(id, now) if rule.is_stealable() else -1
	var free := -1
	var victim := -1
	for i in _voices.size():
		if _voice_end_ms[i] <= now:
			free = i
			break
		if _voice_priority[i] < UNSTEALABLE_BELOW or _voice_priority[i] < rule.priority:
			continue
		if victim < 0 or _voice_priority[i] > _voice_priority[victim] \
				or (_voice_priority[i] == _voice_priority[victim] and _voice_start_ms[i] < _voice_start_ms[victim]):
			victim = i
	if free >= 0:
		return free
	if victim >= 0:
		return victim
	return _oldest_of(id, now) if rule.is_stealable() else -1


func _oldest_of(id: StringName, now: int) -> int:
	var best := -1
	for i in _voices.size():
		if _voice_cue[i] == id and _voice_end_ms[i] > now:
			if best < 0 or _voice_start_ms[i] < _voice_start_ms[best]:
				best = i
	return best


## Chant bed level 0..1 (AUDIO-001 §5). Positional loudness is folded in by the caller.
func set_chant(level: float) -> void:
	_chant_level = clampf(level, 0.0, 1.0)
	if _chant_level > 0.0 and not _chant.playing and not muted_for_tests:
		_chant.play()
		_touch()


## Total silence for `seconds`: every voice and the chant stop (the scare chord, GDD §12).
## The ambience stops hard too and returns with a fade-in once the silence ends (AUDIO-001 §1.4).
func silence(seconds: float) -> void:
	_silence = seconds
	_stop_voices()
	_stop_ambience_players()


## Ambience slot (AUDIO-001 §12.12): crossfades to the loop cue `id` over AMBIENCE_FADE_S on BUS-AMB.
## `level` 0..1 maps to -40..AMBIENCE_MAX_DB dB. &"" fades out. The current id only changes level.
## An unknown or non-loop id is a silent no-op (the gallery may call before cues land).
## `stems` (at most MAX_THREAT_STEMS loop ids, the bed's length) are threat layers locked to the bed's
## playhead and driven by set_threat(); a new bed replaces them (empty = none). Same id: only a
## non-empty `stems` replaces them.
func set_ambience(id: StringName, level: float = 1.0, stems: Array[StringName] = []) -> void:
	_amb_level = clampf(level, 0.0, 1.0)
	if id == _amb_id:
		if not stems.is_empty():
			_set_stems(stems)
		return
	if id != &"" and not _beds.has(id):
		return
	if id != &"":
		_set_stems(stems)
	var old := _amb_active
	if id != &"":
		_amb_active = 1 - _amb_active
		var p := _amb[_amb_active]
		if p.stream != _beds[id]:
			p.stop()
			p.stream = _beds[id]
			_amb_fade[_amb_active] = 0.0
		_amb_level_cur = _amb_level
	_amb_id = id
	if id == &"":
		_amb_active = old


## The id the ambience slot is heading for (&"" = none).
func ambience_id() -> StringName:
	return _amb_id


## Threat 0..1 for the ambience stems (AUDIO-001 §12.18): each stem owns an equal slice of the range
## and the bed gives way by `mix.threat_bed_dip_db` at full threat, so threat adds layers, not level
## (§1.1). Reached over `mix.threat_rise_s` going up and `threat_fall_s` going down.
func set_threat(level: float) -> void:
	_threat = clampf(level, 0.0, 1.0)


## Current (smoothed) threat 0..1 (tests, diagnostics).
func threat() -> float:
	return _threat_cur


## The stem ids the ambience slot carries (tests, diagnostics).
func ambience_stems() -> Array[StringName]:
	return _stem_ids.duplicate()


func _set_stems(stems: Array[StringName]) -> void:
	var ids: Array[StringName] = []
	for s in stems:
		if _beds.has(s) and ids.size() < MAX_THREAT_STEMS:
			ids.append(s)
	_stem_ids = ids
	for i in _stems.size():
		var want: AudioStream = _beds[ids[i]] if i < ids.size() else null
		if _stems[i].stream != want:
			_stems[i].stop()
			_stems[i].stream = want
			_touch()


func _threat_dip_db() -> float:
	return mix.threat_bed_dip_db * _threat_cur if not _stem_ids.is_empty() else 0.0


func _step_stems(delta: float) -> void:
	var span := mix.threat_rise_s if _threat > _threat_cur else mix.threat_fall_s
	_threat_cur = move_toward(_threat_cur, _threat, delta / maxf(span, 0.001))
	var bed := _amb[_amb_active]
	var bed_gain := sin(_amb_fade[_amb_active] * PI * 0.5)
	for i in _stems.size():
		var p := _stems[i]
		var g := FlightMix.stem_gain(_threat_cur, i, _stem_ids.size()) if i < _stem_ids.size() else 0.0
		var on := g > 0.001 and bed.playing and p.stream != null and not muted_for_tests and _silence <= 0.0
		if not on:
			if p.playing:
				p.stop()
				_touch()
			continue
		if not p.playing:
			p.play(bed.get_playback_position())   # locked to the bed: same length, same playhead
			_touch()
		p.volume_db = lerpf(-40.0, AMBIENCE_MAX_DB, _amb_level_cur) + mix.threat_stem_db \
			+ linear_to_db(maxf(g * bed_gain, 0.0001))


# --- flight: the Aether Vigil's engine, boiler, rigging and lantern (AUDIO-001 §12.18) ----------------

## The ship's motion as fractions of its own SYS-001 values (VigilFlightVoice computes them): speed /
## max_speed, thrust 0..1 (0 while braking), turn rate / snap_turn, and whether the brake is held.
## Starts the flight layers; the rigging creak fires as a hard turn begins and the ballast as the brake
## engages at speed. Gameplay never sets a level: FlightMix maps these through `mix`.
func set_flight(speed01: float, thrust01: float, turn01: float, braking: bool) -> void:
	_flight_on = true
	_flight_in = Vector3(clampf(speed01, 0.0, 1.0), clampf(thrust01, 0.0, 1.0), clampf(turn01, 0.0, 1.0))
	if _flight_in.z >= mix.creak_turn_on and _creak_armed:
		_creak_armed = false
		play(FLIGHT_CREAK)
	elif _flight_in.z <= mix.creak_turn_off:
		_creak_armed = true
	if braking and not _was_braking and _flight_in.x >= mix.ballast_min_speed:
		play(FLIGHT_BALLAST)
	_was_braking = braking


## The ship stops being heard (left the sector, hull lost): the layers release over `flight_release_s`.
func stop_flight() -> void:
	_flight_on = false
	_was_braking = false
	_creak_armed = true


## True while the flight layers are asked for (tests, diagnostics).
func flight_active() -> bool:
	return _flight_on


## Current smoothed level (dB) of flight layer `id` (-80 when silent or unknown).
func flight_layer_db(id: StringName) -> float:
	return float(_flight_db.get(id, -80.0))


func _step_flight(delta: float) -> void:
	if _flight.is_empty():
		return
	var quiet := muted_for_tests or _silence > 0.0
	if quiet:
		_flight_return = 0.0
	else:
		_flight_return = move_toward(_flight_return, 1.0, delta / maxf(mix.flight_return_s, 0.001))
	var targets := FlightMix.targets(_flight_in.x, _flight_in.y, _flight_in.z, mix) if _flight_on else {}
	for id: StringName in _flight:
		var p: AudioStreamPlayer = _flight[id]
		if quiet:
			if p.playing:
				p.stop()
				_touch()
			_flight_db[id] = -80.0
			continue
		var want := Vector2(-80.0, 1.0)
		if targets.has(id):
			want = targets[id]
			want.x += linear_to_db(maxf(_flight_return, 0.0001))
		var cur: float = _flight_db[id]
		var tau := mix.flight_attack_s if want.x > cur else mix.flight_release_s
		cur = lerpf(cur, want.x, 1.0 - exp(-delta / maxf(tau, 0.001)))
		_flight_db[id] = cur
		var pitch: float = _flight_pitch[id]
		pitch = lerpf(pitch, want.y, 1.0 - exp(-delta / maxf(mix.flight_attack_s * 2.0, 0.001)))
		_flight_pitch[id] = pitch
		if cur <= mix.flight_floor_db:
			if p.playing:
				p.stop()
				_touch()
			continue
		if not p.playing:
			p.play()
			_touch()
		p.volume_db = cur
		p.pitch_scale = clampf(pitch, BED_PITCH_MIN, 4.0)


# --- ducking: the §7.2 priority chain, a sidechain per bus -------------------------------------------

## Duck offset (dB, <= 0) bus `bus` wants now: the deepest §7.2 duck of any sounding cue (and the chant,
## P2, scaled by its level). A bus carrying a P0/P1 cue is never ducked (§7.3).
func duck_target(bus: StringName) -> float:
	if not (bus in DUCK_BUSES):
		return 0.0
	var now := _now_ms()
	var worst := 0.0
	for i in _voices.size():
		if _voice_end_ms[i] <= now:
			continue
		var pr := _voice_priority[i]
		if _voices[i].bus == bus:
			if pr < DUCK_PROTECT_BELOW:
				return 0.0
			continue
		var hit: Array = DUCK_TARGETS.get(pr, [])
		if bus in hit:
			worst = minf(worst, mix.duck_db(pr))
	var chant_hit: Array = DUCK_TARGETS[2]
	if _chant_level > 0.0 and _chant.playing and bus in chant_hit:
		worst = minf(worst, mix.duck_db(2) * _chant_level)
	return worst


## Current duck offset (dB) on `bus` (tests, diagnostics).
func duck_db(bus: StringName) -> float:
	return float(_duck_cur.get(bus, 0.0))


func _step_ducking(delta: float) -> void:
	var changed := false
	for bus in DUCK_BUSES:
		var target := duck_target(bus)
		var cur: float = _duck_cur.get(bus, 0.0)
		if cur == target:
			continue
		var tau := mix.duck_attack_s if target < cur else mix.duck_release_s
		var nxt := lerpf(cur, target, 1.0 - exp(-delta / maxf(tau, 0.001)))
		if absf(nxt - target) < 0.05:   # inaudible: snap, so the bus returns to exactly its own level
			nxt = target
		_duck_cur[bus] = nxt
		changed = true
	if changed:
		_apply_bus_volumes()


## Every shared bus's volume = its layout volume + subtraction (AMB, MUS) + its duck.
func _apply_bus_volumes() -> void:
	for bus: StringName in _bus_base_db:
		var b := AudioServer.get_bus_index(bus)
		if b < 0:
			continue
		var v: float = float(_bus_base_db[bus]) + float(_duck_cur.get(bus, 0.0))
		if bus in SUBTRACTION_BUSES:
			v += SUBTRACTION_CUT_DB * _sub_cur
		AudioServer.set_bus_volume_db(b, v)


func _stop_ambience_players() -> void:
	_touch()
	for i in 2:
		_amb[i].stop()
		_amb_fade[i] = 0.0
		_amb[i].volume_db = -80.0


func _step_ambience(delta: float) -> void:
	_amb_level_cur = lerpf(_amb_level_cur, _amb_level, clampf(delta * 4.0, 0.0, 1.0))
	for i in 2:
		var p := _amb[i]
		var wanted := i == _amb_active and _amb_id != &""
		if muted_for_tests or _silence > 0.0:
			if p.playing:
				p.stop()
				_touch()
			_amb_fade[i] = 0.0
			continue
		if wanted and not p.playing and p.stream != null:
			_amb_fade[i] = 0.0   # fresh start or return from silence: fade in
			p.volume_db = -80.0
			p.play()
			_touch()
		_amb_fade[i] = move_toward(_amb_fade[i], 1.0 if wanted else 0.0, delta / AMBIENCE_FADE_S)
		var gain := sin(_amb_fade[i] * PI * 0.5)
		p.volume_db = lerpf(-40.0, AMBIENCE_MAX_DB, _amb_level_cur) + _threat_dip_db() + linear_to_db(maxf(gain, 0.0001))
		if not wanted and _amb_fade[i] <= 0.0 and p.playing:
			p.stop()
			_touch()


func _stop_voices() -> void:
	_touch()
	for i in _voices.size():
		_voices[i].stop()
		_voice_end_ms[i] = 0


## Release every stream at shutdown so no playback outlives the engine (no leaks at exit).
## Stopping a player only marks its playback for deletion; the mixer thread frees it on its next
## tick. A voice still sounding at exit would leave the playback and its stream alive past
## engine teardown ("ObjectDB instances leaked", TECH-001 Q-T79), so wait one mixer tick.
func _exit_tree() -> void:
	_duck_cur.clear()
	_apply_subtraction(0.0)   # never leave the shared buses filtered, cut or ducked
	# children leave the tree first, so Player.playing is already false here: use our own books
	# our books lie after silence()/stop_all() zero them while the mixer still holds the playbacks,
	# so the drain is keyed to the wall-clock time since the last start or stop instead
	var drain_ms := SHUTDOWN_DRAIN_MS - (Time.get_ticks_msec() - _touch_ms)
	var players: Array[AudioStreamPlayer] = []
	players.append_array(_voices)
	players.append_array(_amb)
	players.append_array(_stems)
	for id: StringName in _flight:
		players.append(_flight[id] as AudioStreamPlayer)
	if _chant != null:
		players.append(_chant)
	for p in players:
		p.stop()
		p.stream = null
	_cues.clear()
	_beds.clear()
	_flight_streams.clear()
	_trim.clear()
	_rendered.clear()
	if drain_ms > 0:
		OS.delay_msec(drain_ms)


func stop_all() -> void:
	set_subtraction(0.0)
	_stop_voices()
	_stop_ambience_players()
	_amb_id = &""
	_chant_level = 0.0
	_chant.stop()
	_touch()
	_bed_pitch_target = 1.0
	_chant.pitch_scale = 1.0
	stop_flight()
	_threat = 0.0
	_threat_cur = 0.0
	_set_stems([])


## Slow-mo bend of the chant bed only (AUDIO-001 §12.11). The caller passes a scale; the bed glides
## to it in _process. One-shot voices are never bent. Clamped to a safe range (✱ safety only).
func set_bed_pitch_scale(scale: float) -> void:
	_bed_pitch_target = clampf(scale, BED_PITCH_MIN, 1.0)


## Current chant bed pitch_scale (tests, diagnostics).
func bed_pitch_scale() -> float:
	return _chant.pitch_scale if _chant != null else 1.0


func _step_bed_pitch(delta: float) -> void:
	var cur := _chant.pitch_scale
	if is_equal_approx(cur, _bed_pitch_target):
		_chant.pitch_scale = _bed_pitch_target
		return
	var down := _bed_pitch_target < cur
	var span := (1.0 - BED_PITCH_MIN)
	var rate := span / (BED_PITCH_FALL_S if down else BED_PITCH_RISE_S)   # linear, units per second
	_chant.pitch_scale = move_toward(cur, _bed_pitch_target, rate * delta)


func _process(delta: float) -> void:
	_step_subtraction(delta)
	_step_bed_pitch(delta)
	_silence = maxf(0.0, _silence - delta)
	_step_ambience(delta)
	_step_stems(delta)
	_step_flight(delta)
	_step_ducking(delta)
	var target := -80.0
	if _chant_level > 0.0 and _silence <= 0.0:
		target = lerpf(-40.0, CHANT_MAX_DB, _chant_level)
	_chant.volume_db = lerpf(_chant.volume_db, target, clampf(delta * 4.0, 0.0, 1.0))
	if _chant.volume_db < -79.0 and _chant.playing and _chant_level <= 0.0:
		_chant.stop()
		_touch()


# --- subtraction: the entity has no sound, it is heard as sound removed (AUDIO-001 §12.14) ---------

## Removes sound from the ambience and music buses only: `amount` 0..1 (clamped) is reached linearly
## over `ramp_s` seconds (the caller passes the lead; nothing here knows the Passing's timing).
## At 0 the low-pass is bypassed and the buses are back at their own volume. BUS-ENT, BUS-CHO,
## BUS-FLY and BUS-UI are never touched: information cues are never removed (L3).
func set_subtraction(amount: float, ramp_s: float = 0.0) -> void:
	_sub_target = clampf(amount, 0.0, 1.0)
	_sub_from = _sub_cur
	_sub_ramp_s = maxf(ramp_s, 0.0)
	_sub_t = 0.0
	if _sub_ramp_s <= 0.0:
		_apply_subtraction(_sub_target)


## Current subtraction amount 0..1 (tests, diagnostics).
func subtraction() -> float:
	return _sub_cur


func _step_subtraction(delta: float) -> void:
	if _sub_cur == _sub_target:
		return
	_sub_t += delta
	if _sub_t >= _sub_ramp_s:
		_apply_subtraction(_sub_target)
	else:
		_apply_subtraction(lerpf(_sub_from, _sub_target, _sub_t / _sub_ramp_s))


## Runtime effects (not in the bus layout): the layout stays a plain list of buses, and the filter
## only exists while this service does. Reused when a previous service already added it.
func _setup_subtraction() -> void:
	for bus in SUBTRACTION_BUSES:
		var b := AudioServer.get_bus_index(bus)
		if b < 0:
			continue
		var fx := -1
		for i in AudioServer.get_bus_effect_count(b):
			if AudioServer.get_bus_effect(b, i) is AudioEffectLowPassFilter:
				fx = i
				break
		if fx < 0:
			var lp := AudioEffectLowPassFilter.new()
			lp.cutoff_hz = SUBTRACTION_OPEN_HZ
			AudioServer.add_bus_effect(b, lp)
			fx = AudioServer.get_bus_effect_count(b) - 1
		_sub_fx[bus] = fx
	for bus in DUCK_BUSES:
		var b := AudioServer.get_bus_index(bus)
		if b >= 0:
			_bus_base_db[bus] = AudioServer.get_bus_volume_db(b)
	_apply_subtraction(0.0)


func _apply_subtraction(amount: float) -> void:
	_sub_cur = amount
	for bus: StringName in _sub_fx:
		var b := AudioServer.get_bus_index(bus)
		var fx: int = _sub_fx[bus]
		var lp := AudioServer.get_bus_effect(b, fx) as AudioEffectLowPassFilter
		if lp != null:
			lp.cutoff_hz = SUBTRACTION_OPEN_HZ * pow(SUBTRACTION_CLOSED_HZ / SUBTRACTION_OPEN_HZ, amount)
		AudioServer.set_bus_effect_enabled(b, fx, amount > 0.0)
	_apply_bus_volumes()
